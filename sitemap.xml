---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}{% if p.layout == 'base' %}
<url><loc>{{ site.url }}{{ p.url | replace: 'index.html', '' }}</loc></url>
{%- endif %}{% endfor %}
{%- for a in site.posts %}
<url><loc>{{ site.url }}{{ a.url }}</loc><lastmod>{{ a.date | date_to_xmlschema }}</lastmod></url>
{%- endfor %}
</urlset>
